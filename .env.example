# URL pública do site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://schiavon.dev

# API do portfólio (projetos, tecnologias e imagens em /uploads)
NEXT_PUBLIC_API_URL=https://server-main.schiavon.dev

# Opcional: URL interna da API para as leituras feitas pelo servidor do Next
# (ex.: http://127.0.0.1:8000 quando os dois rodam na mesma máquina).
# Se vazio, usa NEXT_PUBLIC_API_URL.
API_URL=

# Opcional: código de verificação do Google Search Console
GOOGLE_VERIFICATION_CODE=
